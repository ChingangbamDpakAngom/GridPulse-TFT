# GridPulse-TFT Environment Variables
# Copy to .env and fill in actual values - NEVER commit .env

# National Grid ESO API (no auth required for carbon intensity)
GRID_ESO_API_BASE=https://api.carbonintensity.org.uk

# UK Met Office Weather DataHub site-specific API (requires API key)
# Register at https://datahub.metoffice.gov.uk/ and subscribe to Site Specific forecasts
MET_OFFICE_API_BASE=https://data.hub.api.metoffice.gov.uk/sitespecific/v0/point
MET_OFFICE_API_KEY=

# Weights & Biases
WANDB_API_KEY=
WANDB_PROJECT=gridpulse-tft

# LLM Provider (deepseek or gemini)
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# Server
APP_HOST=0.0.0.0
APP_PORT=8000

# Reproducibility
SEED=42

# Rate limiting (requests per minute per client)
RATE_LIMIT_PER_MIN=60

# LLM timeout (seconds)
LLM_TIMEOUT_SECONDS=5

# Drift detection KS threshold
DRIFT_KS_THRESHOLD=0.15
